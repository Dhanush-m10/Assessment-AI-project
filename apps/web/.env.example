# apps/web environment variables
#
# Copy this file to apps/web/.env.local and replace placeholders with real
# values. .env.local is gitignored - real values must NEVER be committed.
#
# --- DATABASE_URL ---
# Why:         Prisma datasource connection string for PostgreSQL (runtime).
# Provider:    Supabase -> Project Settings -> Database -> connection string
#              ("Transaction" pooler, port 6543).
# Scope:       Server-only. Never expose to the browser.
# Placement:   apps/web/.env.local
# Gitignored:  Yes (.env.local matches .env.* in the root .gitignore).
#
# --- DIRECT_URL ---
# Why:         Prisma Migrate needs a direct/session-pooler connection; the
#              transaction pooler breaks `prisma migrate dev`.
# Provider:    Supabase -> Project Settings -> Database -> connection string
#              ("Session" pooler, port 5432).
# Scope:       Server-only. Never expose to the browser.
# Placement:   apps/web/.env.local
# Gitignored:  Yes.

# --- NEXT_PUBLIC_SUPABASE_URL ---
# Why:         Base URL for every Supabase Auth call (browser + server).
# Provider:    Supabase -> Project Settings -> API -> Project URL.
# Scope:       Browser-safe (public by design). Authorization is still
#              enforced server-side; this value grants no privilege.
# Placement:   apps/web/.env.local
# Gitignored:  Yes.
#
# --- NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY ---
# Why:         Public API key authenticating clients to Supabase Auth
#              (current key model; replaces the legacy anon key, which is
#              being deprecated). If your dashboard still shows only the
#              legacy "anon public" key, its VALUE works here too - store it
#              under this variable name.
# Provider:    Supabase -> Project Settings -> API Keys -> publishable key
#              (sb_publishable_...).
# Scope:       Browser-safe by design. NEVER put a secret key (sb_secret_...
#              / legacy service_role) in a NEXT_PUBLIC_* variable.
# Placement:   apps/web/.env.local
# Gitignored:  Yes.
#
# NOTE: No Supabase secret key is used in Phase 2. One will be introduced
# only when a concrete privileged server-side operation requires it.

DATABASE_URL="YOUR_DATABASE_URL_HERE"
DIRECT_URL="YOUR_DIRECT_URL_HERE"
NEXT_PUBLIC_SUPABASE_URL="YOUR_SUPABASE_PROJECT_URL_HERE"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_PUBLISHABLE_KEY_HERE"
